    <Folder>
      <name>Lak Lake</name>
      <Placemark>
        <name>Lak Lake</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Lak Lake</b><br/>Highlands<br/><a href="https://www.google.com/maps/dir/?api=1&destination=12.4076,108.1836&travelmode=driving" style="color:#0f7c5c;font-weight:700">Directions</a><br/>Coords: 12.4076, 108.1836]]></description>
