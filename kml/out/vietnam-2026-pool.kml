          <coordinates>105.7469,10.0452,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Phu Quoc</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Phu Quoc</b><br/>South]]></description>
        <Point>
          <coordinates>103.984,10.2899,0</coordinates>
        </Point>
      </Placemark>
