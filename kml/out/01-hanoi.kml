    <Folder>
      <name>Hanoi</name>
      <Placemark>
        <name>Hanoi</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Hanoi</b><br/>North<br/><a href="https://www.google.com/maps/dir/?api=1&destination=21.0285,105.8522&travelmode=driving">Directions</a><br/>Coords: 21.0285, 105.8522]]></description>
        <Point>
          <coordinates>105.8522,21.0285,0</coordinates>
        </Point>
      </Placemark>
