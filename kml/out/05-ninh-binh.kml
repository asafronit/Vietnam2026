    <Folder>
      <name>Ninh Binh</name>
      <Placemark>
        <name>Ninh Binh</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Ninh Binh</b><br/>North<br/><a href="https://www.google.com/maps/dir/?api=1&destination=20.2505,105.9745&travelmode=driving" style="color:#0f7c5c;font-weight:700">Directions</a><br/>Coords: 20.2505, 105.9745]]></description>
