    <Folder>
      <name>Hoi An and Da Nang</name>
      <Placemark>
        <name>Hoi An and Da Nang</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Hoi An and Da Nang</b><br/>Central<br/><a href="https://www.google.com/maps/dir/?api=1&destination=15.8801,108.338&travelmode=driving">Directions</a><br/>Coords: 15.8801, 108.338]]></description>
        <Point>
          <coordinates>108.338,15.8801,0</coordinates>
        </Point>
      </Placemark>
