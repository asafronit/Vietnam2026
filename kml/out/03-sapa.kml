    <Folder>
      <name>Sapa</name>
      <Placemark>
        <name>Sapa</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Sapa</b><br/>North<br/><a href="https://www.google.com/maps/dir/?api=1&destination=22.3364,103.844&travelmode=driving" style="color:#0f7c5c;font-weight:700">Directions</a><br/>Coords: 22.3364, 103.844]]></description>
