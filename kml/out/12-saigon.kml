    <Folder>
      <name>Ho Chi Minh City</name>
      <Placemark>
        <name>Ho Chi Minh City</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Ho Chi Minh City</b><br/>South<br/><a href="https://www.google.com/maps/dir/?api=1&destination=10.7769,106.7009&travelmode=driving">Directions</a><br/>Coords: 10.7769, 106.7009]]></description>
