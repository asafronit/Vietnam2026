    <Folder>
      <name>Mekong and Can Tho</name>
      <Placemark>
        <name>Mekong and Can Tho</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Mekong and Can Tho</b><br/>South<br/><a href="https://www.google.com/maps/dir/?api=1&destination=10.0452,105.7469&travelmode=driving" style="color:#0f7c5c;font-weight:700">Directions</a><br/>Coords: 10.0452, 105.7469]]></description>
        <Point>
          <coordinates>105.7469,10.0452,0</coordinates>
        </Point>
      </Placemark>
