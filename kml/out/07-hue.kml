    <Folder>
      <name>Hue</name>
      <Placemark>
        <name>Hue</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Hue</b><br/>Central<br/><a href="https://www.google.com/maps/dir/?api=1&destination=16.4637,107.5909&travelmode=driving">Directions</a><br/>Coords: 16.4637, 107.5909]]></description>
