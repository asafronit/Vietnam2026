    <Folder>
      <name>Phong Nha</name>
      <Placemark>
        <name>Phong Nha</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Phong Nha</b><br/>Central<br/><a href="https://www.google.com/maps/dir/?api=1&destination=17.5934,106.2865&travelmode=driving">Directions</a><br/>Coords: 17.5934, 106.2865]]></description>
