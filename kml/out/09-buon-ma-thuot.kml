    <Folder>
      <name>Buon Ma Thuot</name>
      <Placemark>
        <name>Buon Ma Thuot</name>
        <styleUrl>#place-anchor</styleUrl>
        <description><![CDATA[<b>Buon Ma Thuot</b><br/>Highlands<br/><a href="https://www.google.com/maps/dir/?api=1&destination=12.6797,108.0378&travelmode=driving">Directions</a><br/>Coords: 12.6797, 108.0378]]></description>
